# Required: Discogs personal access token (https://www.discogs.com/settings/developers -> "Generate new token")
DISCOGS_TOKEN=

# Optional: YouTube Data API v3 key. Enables reading video descriptions
# (Discogs links, catalog numbers, "Provided to YouTube by ..." metadata).
YOUTUBE_API_KEY=

# Optional: Odesli / song.link API key (raises the ~10 req/min anonymous limit).
ODESLI_KEY=

# Optional: contact info sent in the User-Agent (MusicBrainz asks for one).
# e.g. a URL or email address.
SOURCETRAX_CONTACT=
